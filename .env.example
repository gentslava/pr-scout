# --- Jev: one of the two providers ---
# TypeSafe — https://console.typesafe.ai
TYPESAFE_API_KEY=
# ...or NordRouter — https://nordrouter.com (the same Jev, $0.05 per 1M input tokens).
NORDROUTER_API_KEY=
# With one key set, the provider follows it. With both, TypeSafe wins unless this says nordrouter.
JEV_PROVIDER=
# Overrides; empty means the provider's own endpoint, model and price per 1M input tokens.
JEV_API_URL=
JEV_MODEL=
JEV_PRICE_PER_MTOK=

# Recommended: protects the UI with HTTP Basic auth (any user name, this password)
APP_PASSWORD=

# Recommended: a GitHub token without scopes — 5000 req/h instead of 60, CI status of finalists.
# Required for fetching issues and forks, and for descriptions (the GraphQL API does not answer anonymously).
GITHUB_TOKEN=

# --- LLM for writing missing PR descriptions (chosen per project in its settings) ---
# Ollama on the Docker host: needs no key.
OLLAMA_URL=http://host.docker.internal:11434
# OpenAI-compatible providers: a key turns the built-in preset on.
# NordRouter uses NORDROUTER_API_KEY from the Jev section above.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Any other OpenAI-compatible endpoint (vLLM, LM Studio, DeepSeek, Groq, a company gateway…):
LLM_API_URL=
LLM_API_KEY=
LLM_API_NAME=
LLM_MODEL=
# ...or several at once, as JSON on one line (`key` for the key, `model` for a default model):
# LLM_PROVIDERS=[{"id":"vllm","name":"vLLM","url":"http://gpu:8000/v1"},{"id":"groq","name":"Groq","url":"https://api.groq.com/openai/v1","key":"gsk_..."}]
LLM_PROVIDERS=
# NordRouter's default model for descriptions, and parallel requests to cloud providers.
DESCRIBER_MODEL=google/gemini-3.1-flash-lite
DESCRIBER_WORKERS=6

# Optional: host port for the UI
SCOUT_PORT=8000

# Optional: concurrency. NordRouter rate-limits /v1/evaluate to 15 rps, so 14/10 stay under it.
JEV_STAGE1_WORKERS=14
JEV_STAGE2_WORKERS=10
# Test merges run in parallel git worktrees; git is CPU and disk bound, so about the core count.
JEV_MERGE_WORKERS=4
# Fork mining: parallel compare requests. GitHub REST allows 5000/h; the job waits for the hourly
# reset instead of failing, so a walk over thousands of forks can span several windows.
FORK_REST_WORKERS=16
# Fork list: numbered REST pages pulled several at a time (8 pages × 100 forks per round).
FORK_LIST_WORKERS=8
